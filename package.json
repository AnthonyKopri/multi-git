{
  "name": "multi-git",
  "version": "2.2.0",
  "description": "A lightweight Git GUI client with dynamic SSH key switching",
  "main": "out/node/main/main.js",
  "scripts": {
    "start": "npm run compile && node out/node/server/index.js",
    "dev": "npm run compile && node out/node/server/index.js",
    "desktop": "npm run compile && electron .",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "build": "npm run compile && electron-builder",
    "build-win": "npm run compile && electron-builder --win nsis portable",
    "build-standalone": "npm run compile && electron-builder --win portable --config.directories.output=dist-standalone",
    "release": "node scripts/release.js",
    "release:installer": "node scripts/release.js --target installer",
    "release:portable": "node scripts/release.js --target portable"
  },
  "keywords": [
    "git",
    "gui",
    "ssh",
    "github",
    "multi-account"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.0",
    "@types/supertest": "^6.0.2",
    "electron": "^42.3.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "rcedit": "^5.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.multigit.client",
    "productName": "Multi-Git Client",
    "files": [
      "out/**/*",
      "templates/**/*",
      "Multi Git Logo.ico",
      "package.json"
    ],
    "icon": "Multi Git Logo.ico",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
