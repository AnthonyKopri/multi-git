{
  "name": "multi-git",
  "version": "4.0.0",
  "description": "A local-first Git desktop client for multiple repositories, accounts, and SSH identities",
  "main": "out/node/main/main.js",
  "scripts": {
    "start": "npm run compile && node out/node/server/cli.js",
    "dev": "npm run compile && node out/node/server/cli.js",
    "desktop": "npm run compile && node scripts/ensure-electron.mjs && electron .",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint:links": "node scripts/check-links.mjs",
    "test": "npm run typecheck && vitest run",
    "build": "npm run compile && electron-builder",
    "build-win": "npm run compile && electron-builder --win nsis portable",
    "build-mac": "npm run compile && electron-builder --mac dmg zip --publish never",
    "build-mac:arm64": "npm run compile && electron-builder --mac dmg zip --arm64 --publish never",
    "build-mac:x64": "npm run compile && electron-builder --mac dmg zip --x64 --publish never",
    "build-mac:portable": "npm run compile && electron-builder --mac zip --publish never",
    "build-standalone": "npm run compile && electron-builder --win portable --config.directories.output=dist-standalone",
    "release": "node scripts/release.js",
    "release:installer": "node scripts/release.js --target installer",
    "release:portable": "node scripts/release.js --target portable",
    "release:mac:arm64": "node scripts/release.js --target mac-arm64",
    "release:mac:x64": "node scripts/release.js --target mac-x64",
    "release:upload": "node scripts/upload-release-assets.js",
    "release:ship": "node scripts/ship.js",
    "release:verify": "node scripts/verify-release.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "git",
    "gui",
    "ssh",
    "github",
    "multi-account"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.2",
    "rcedit": "^5.0.2",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.multigit.client",
    "productName": "Multi-Git Client",
    "files": [
      "out/**/*",
      "templates/**/*",
      "docs/images/multi-git-logo.ico",
      "docs/images/multi-git-logo.png",
      "package.json"
    ],
    "icon": "docs/images/multi-git-logo.ico",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "icon": "docs/images/multi-git-logo.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "docs/images/multi-git-logo.png",
      "artifactName": "Multi-Git-Client-macOS-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Git repository folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      },
      "hardenedRuntime": true,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "Multi-Git-Client-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Multi-Git-Client-Portable-${version}.${ext}"
    }
  }
}
