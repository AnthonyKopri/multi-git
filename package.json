{
  "name": "multi-git",
  "version": "4.1.4",
  "description": "A local-first Git desktop client for multiple repositories, accounts, and SSH identities",
  "homepage": "https://github.com/AnthonyKopri/multi-git",
  "desktopName": "multi-git.desktop",
  "main": "out/node/main/main.js",
  "bin": {
    "multi-git": "scripts/multi-git.cjs"
  },
  "scripts": {
    "agent": "node scripts/multi-git.cjs",
    "start": "npm run compile && node out/node/server/cli.js",
    "dev": "npm run compile && node out/node/server/cli.js",
    "desktop": "npm run compile && node scripts/ensure-electron.mjs && electron .",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint:links": "node scripts/check-links.mjs",
    "test": "npm run typecheck && vitest run",
    "build": "npm run compile && electron-builder",
    "build-win": "npm run compile && electron-builder --win nsis portable",
    "build-standalone": "npm run compile && electron-builder --win portable --config.directories.output=dist-standalone",
    "release": "node scripts/release.js",
    "release:installer": "node scripts/release.js --target installer",
    "release:portable": "node scripts/release.js --target portable",
    "release:prepare": "node scripts/prepare-release.js",
    "release:notes": "node scripts/release-notes.js",
    "release:upload": "node scripts/upload-release-assets.js",
    "release:verify": "node scripts/verify-release.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "git",
    "gui",
    "ssh",
    "github",
    "multi-account"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.12.0",
    "rcedit": "^5.0.2",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.multigit.client",
    "productName": "Multi-Git Client",
    "files": [
      "out/**/*",
      "scripts/multi-git.cjs",
      "skills/**/*",
      "templates/**/*",
      "docs/images/multi-git-logo.ico",
      "docs/images/multi-git-logo.png",
      "package.json"
    ],
    "icon": "docs/images/multi-git-logo.ico",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Multi-Git-Client-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Multi-Git-Client-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "docs/images/multi-git_icon.svg",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Multi-Git-Client-macOS-${version}.${ext}"
    },
    "linux": {
      "icon": "docs/images/multi-git-logo.png",
      "category": "Development",
      "synopsis": "Git client for multiple repositories, accounts, and SSH identities",
      "maintainer": "AnthonyKopri <62609903+AnthonyKopri@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Multi-Git-Client-Linux-${version}-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "Multi-Git-Client-Linux-${version}-amd64.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2",
        "libgbm1",
        "git"
      ],
      "recommends": [
        "openssh-client"
      ]
    },
    "rpm": {
      "artifactName": "Multi-Git-Client-Linux-${version}-x86_64.${ext}",
      "depends": [
        "(gtk3 or libgtk-3-0)",
        "(libnotify or libnotify4)",
        "(nss or mozilla-nss)",
        "(libXScrnSaver or libXss1)",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(alsa-lib or libasound2)",
        "(mesa-libgbm or libgbm1)",
        "git"
      ]
    }
  }
}
