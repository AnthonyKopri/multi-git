# Dependencies do not run install scripts here.
#
# A preinstall or postinstall script runs with the installing user's full
# access: on a developer machine that means SSH keys, gh tokens and every
# repository on disk, and in CI the runner a release is built on. It is the
# way the npm worms of 2025 and 2026 (Shai-Hulud and its successors) spread,
# and nothing this project depends on needs one:
#
#   electron            has no install script; scripts/ensure-electron.mjs
#                       fetches the runtime for `npm run desktop`, and
#                       electron-builder fetches its own
#   esbuild             its postinstall only double-checks the platform
#                       binary that npm already installed as an optional
#                       dependency
#   electron-winstaller only for Squirrel.Windows, which is not built
#   fsevents            a macOS file watcher for Vitest, shipped prebuilt
#
# Scripts this project runs itself, `npm test` or `npm run build`, are not
# affected. If a future dependency does need its script, run it explicitly
# with `npm rebuild <package> --ignore-scripts=false` after reviewing it.
ignore-scripts=true
